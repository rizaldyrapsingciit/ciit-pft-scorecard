rules_version = '2';

// CIIT PFT Scorecard — Firestore security rules
// Only signed-in users whose email ends with an allowed CIIT domain may read
// or write the shared classes and scorecards. Copy these into the Firebase
// console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isCiit() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@ciit[.]edu[.]ph$');
    }

    match /records/{id} {
      allow read, write: if isCiit();
    }

    match /classes/{id} {
      allow read, write: if isCiit();
    }
  }
}
